{
  "id": "workspace-lane-guard",
  "name": "Workspace Lane Guard",
  "description": "Guards native subagent delegation with authenticated lanes and durable hierarchical workspace reservations.",
  "version": "0.1.0",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "trustedToolPolicies": ["workspace-lane-admission"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["stateDir", "openclawVersion", "targets"],
    "properties": {
      "stateDir": {
        "type": "string",
        "minLength": 1
      },
      "openclawVersion": {
        "type": "string",
        "enum": ["2026.7.2-beta.4"]
      },
      "acquisitionDeadlineMs": {
        "type": "integer",
        "minimum": 50,
        "maximum": 500,
        "default": 500
      },
      "targets": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentId", "workspaceRoot", "access", "tools", "model", "thinking"],
          "properties": {
            "agentId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "workspaceRoot": {
              "type": "string",
              "minLength": 1
            },
            "access": {
              "enum": ["ro", "rw"]
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "thinking": {
              "type": "string",
              "minLength": 1
            },
            "sameRootPair": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
